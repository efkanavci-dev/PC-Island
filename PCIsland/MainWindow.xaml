<Window x:Class="PCIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Island" Width="520" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Shadow" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                Width="126" Height="34" CornerRadius="17" Background="#01000000" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.45" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                Width="126" Height="34" CornerRadius="17" BorderThickness="1" ClipToBounds="True"
                MouseLeftButtonUp="Island_Click" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.ContextMenu>
                <ContextMenu x:Name="Menu"/>
            </Border.ContextMenu>
            <Grid x:Name="Inner">
            <Border x:Name="Tint" IsHitTestVisible="False"/>
            <Border x:Name="Shine" IsHitTestVisible="False" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="ShineTop" Color="#16FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="ShineEdge" Color="#55FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Border x:Name="Shimmer" IsHitTestVisible="False" Opacity="0" Width="120" HorizontalAlignment="Left">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop x:Name="ShimmerMid" Color="#2EFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ShimmerMove" X="-120"/>
                </Border.RenderTransform>
            </Border>
            <Grid x:Name="Body" Margin="16,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Ellipse x:Name="IdleDot" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="TypePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="TypeDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="Input" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             FontSize="15" FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center"
                             PreviewKeyDown="Input_KeyDown"/>
                    <TextBlock x:Name="Ghost" Grid.Column="1" IsHitTestVisible="False" FontSize="15" Margin="2,0,0,0"
                               VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI">
                        <Run x:Name="GhostTyped" Foreground="Transparent"/><Run x:Name="GhostRest"/>
                    </TextBlock>
                    <TextBlock x:Name="Hint" Grid.Column="1" IsHitTestVisible="False" FontSize="15" Margin="2,0,0,0"
                               VerticalAlignment="Center" Text="Open, close, search... (help for all)"/>
                </Grid>

                <Grid x:Name="MsgPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="MsgDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Image x:Name="MsgIcon" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="MsgText" Grid.Column="1" FontSize="15" TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Center" Margin="0,12"/>
                    <TextBlock x:Name="MsgMark" Grid.Column="2" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid x:Name="LivePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Bars" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="0,0,9,0">
                        <Rectangle x:Name="Bar1" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar2" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0" VerticalAlignment="Bottom"/>
                        <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="LiveIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="LiveText" Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid x:Name="MusicPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="MusicTitle" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MusicArtist" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PrevBtn" Width="34" Height="34" CornerRadius="17" Cursor="Hand" Background="Transparent">
                            <TextBlock x:Name="PrevIcon" Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="PlayBtn" Width="38" Height="38" CornerRadius="19" Cursor="Hand" Margin="4,0">
                            <TextBlock x:Name="PlayIcon" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="NextBtn" Width="34" Height="34" CornerRadius="17" Cursor="Hand" Background="Transparent">
                            <TextBlock x:Name="NextIcon" Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="LevelPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LevelIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LevelLabel" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Grid Grid.Column="2" Height="6" VerticalAlignment="Center">
                        <Border x:Name="LevelTrack" CornerRadius="3"/>
                        <Border x:Name="LevelFill" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="LevelValue" Grid.Column="3" FontSize="14" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="ConfTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ConfSub" FontSize="12" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="NoBtn" CornerRadius="13" Padding="0,7" Cursor="Hand" MouseLeftButtonUp="No_Click">
                            <TextBlock x:Name="NoText" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        </Border>
                        <Border x:Name="YesBtn" Grid.Column="2" CornerRadius="13" Padding="0,7" Cursor="Hand" MouseLeftButtonUp="Yes_Click">
                            <TextBlock x:Name="YesText" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="PickPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="PickTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="PickList"/>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
